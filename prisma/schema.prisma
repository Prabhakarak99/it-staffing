// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  roleScreens RoleScreen[]
}

model Screen {
  id          String  @id @default(cuid())
  name        String  @unique
  path        String  @unique
  description String?

  roleScreens RoleScreen[]
}

model RoleScreen {
  id       String  @id @default(cuid())
  roleId   String
  screenId String
  canView  Boolean @default(true)

  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  screen Screen @relation(fields: [screenId], references: [id], onDelete: Cascade)

  @@unique([roleId, screenId])
}

model User {
  id                     String    @id @default(cuid())
  firstName              String
  lastName               String
  email                  String    @unique
  phoneNumber            String?
  password               String
  roleId                 String?
  isActive               Boolean   @default(false)
  /// Admin switch for the Easy Submissions tab (on top of the role's screen access)
  easySubmissionsEnabled Boolean   @default(false)
  /// Plain-text signature added to the user's emails (Easy Submissions, follow-ups)
  emailSignature         String?
  activationToken        String?   @unique
  activationExpiry       DateTime?
  resetToken             String?   @unique // admin-sent password reset link
  resetExpiry            DateTime?
  businessNumber         String?
  fullAddress            String?
  experience             String?
  salary                 String?
  bankName               String?
  accountNumber          String?
  ifscCode               String?
  bankBranch             String?
  accountType            String?
  blackChequeDocument    String?
  startDate              DateTime?
  endDate                DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  role                         Role?                @relation(fields: [roleId], references: [id])
  submissions                  Submission[]
  interviews                   Interview[]
  preMarketings                PreMarketing[]       @relation("PreMarketingRecruiter")
  expenses                     Expense[]            @relation("ExpenseSubmitter")
  vendorContacts               RecruiterVendor[]
  gmailAccount                 GmailAccount?
  emailStats                   EmailDailyStat[]
  leads                        Lead[]               @relation("LeadCreator")
  attendance                   Attendance[]         @relation("AttendanceUser")
  attendanceReviews            Attendance[]         @relation("AttendanceReviewer")
  leaveRequests                LeaveRequest[]       @relation("LeaveUser")
  leaveReviews                 LeaveRequest[]       @relation("LeaveReviewer")
  tailoredResumes              TailoredResume[]
  easySends                    EasySubmissionSend[]
  followUps                    FollowUp[]
  emailTemplates               EmailTemplate[]
  emailRequirements            EmailRequirement[]
  consultantMailboxesConnected ConsultantMailbox[]
}

model Student {
  id                     String    @id @default(cuid())
  // Personal
  firstName              String
  lastName               String
  personalPhone          String?
  email                  String    @unique
  dob                    DateTime?
  parentPhone            String?
  emergencyContact       String?
  referredBy             String?
  // Address
  addressLine1           String?
  addressLine2           String?
  city                   String?
  state                  String?
  zipCode                String?
  // University
  universityName         String?
  universityLocation     String?
  masters                String?
  mastersCompletedDate   String?
  dsoName                String?
  dsoEmail               String?
  dsoPhone               String?
  // Visa
  visaStatus             String?
  visaStartDate          DateTime?
  visaExpiryDate         DateTime?
  // Onboarding
  onboardingStartDate    DateTime?
  offerLetterType        String?
  payRate                String?
  hasDL                  String?
  hasSSN                 String?
  passportNumber         String?
  // Documents (stored filenames)
  dlDocument             String?
  passportDocument       String?
  visaCopyDocument       String?
  // Job Card
  projectStatus          String?
  jobTitle               String?
  marketingStartDate     DateTime?
  verbalConfirmationDate DateTime?
  linkedInterviewId      String?
  projectStartDate       DateTime?
  billRate               String?
  payroll                String?
  workMode               String?
  pmName                 String?
  pmEmail                String?
  pmPhone                String?
  driveLocation          String?
  // Legacy / search
  phoneNumber            String?
  technology             String?
  // Resume (file in the private resume store, see src/lib/files/resumes.ts)
  resumeFile             String?
  resumeFileName         String?
  resumeUpdatedAt        DateTime?
  comments               Json?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  submissions         Submission[]
  preMarketings       PreMarketing[]
  expenses            Expense[]              @relation("ExpenseConsultant")
  leads               Lead[]
  autoJobApplications AutoJobApplication[]
  tailoredResumes     TailoredResume[]
  easySends           EasySubmissionSend[]
  mailbox             ConsultantMailbox?
  vendorResumeSends   VendorResumeSend[]
  requirementSends    EmailRequirementSend[]
}

model Submission {
  id                   String   @id @default(cuid())
  submissionId         String   @unique
  submissionDate       DateTime
  recruiterId          String
  consultantId         String
  technology           String
  jobDescription       String?
  payRate              String?
  vendorCompany        String
  vendorRecruiterName  String
  vendorRecruiterEmail String
  vendorRecruiterPhone String
  implementationName   String?
  implementationEmail  String?
  implementationPhone  String?
  clientName           String?
  clientLocation       String?
  status               String   @default("Submission Submitted")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  recruiter       User                 @relation(fields: [recruiterId], references: [id])
  consultant      Student              @relation(fields: [consultantId], references: [id])
  interviews      Interview[]
  tailoredResumes TailoredResume[]
  easySends       EasySubmissionSend[]
  followUps       FollowUp[]
}

model TechSupport {
  id           String   @id @default(cuid())
  firstName    String
  lastName     String
  email        String   @unique
  phoneNumber  String
  technology   String
  location     String
  availability String?
  calendarLink String?
  amount       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  interviews Interview[]
}

model Interview {
  id                  String   @id @default(cuid())
  interviewId         String   @unique
  recruiterId         String
  submissionId        String
  interviewStartDate  DateTime
  interviewEndDate    DateTime
  interviewLevel      String
  interviewStatus     String
  techSupportId       String?
  amount              String?
  techSupportFeedback String?
  otterLink           String?
  interviewQuestions  String?
  interviewFeedback   String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  recruiter   User         @relation(fields: [recruiterId], references: [id])
  submission  Submission   @relation(fields: [submissionId], references: [id])
  techSupport TechSupport? @relation(fields: [techSupportId], references: [id])
  followUps   FollowUp[]
}

model PreMarketing {
  id                              String    @id @default(cuid())
  consultantId                    String    @unique
  checklist                       Json?
  dlAvailable                     String?
  visaAvailable                   String?
  ssnAvailable                    String?
  marketingSheetReady             String?
  marketingSheetExplained         String?
  marketingSheetReverseKT         String?
  allTrainingSessionsCompleted    String?
  allTrainingAssignmentsCompleted String?
  marketingEmail                  String?
  marketingVisaStatus             String?
  marketingStartDate              DateTime?
  marketingEndDate                DateTime?
  recruiterId                     String?
  createdAt                       DateTime  @default(now())
  updatedAt                       DateTime  @updatedAt

  consultant Student @relation(fields: [consultantId], references: [id])
  recruiter  User?   @relation("PreMarketingRecruiter", fields: [recruiterId], references: [id])
}

model Expense {
  id            String   @id @default(cuid())
  expenseId     String   @unique
  date          DateTime
  submittedById String
  consultantId  String?
  category      String
  description   String?
  amount        Float
  location      String
  receiptFile   String?
  status        String   @default("Pending")
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  submittedBy User     @relation("ExpenseSubmitter", fields: [submittedById], references: [id])
  consultant  Student? @relation("ExpenseConsultant", fields: [consultantId], references: [id])
}

model Lead {
  id             String    @id @default(cuid())
  consultantId   String?   @unique
  consultantName String
  phoneNumber    String?
  email          String
  visaStatus     String?
  university     String?
  state          String?
  optStartDate   DateTime?
  status         String    @default("Interested") // see LEAD_STATUSES in src/lib/leads/fields.ts
  comments       String?
  createdById    String? // who added the lead; null for leads created before ownership was tracked
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  consultant Student? @relation(fields: [consultantId], references: [id])
  createdBy  User?    @relation("LeadCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([createdById])
}

/// One-time data changes that already ran (see src/lib/screens.ts)
model AppMigration {
  id    String   @id
  ranAt DateTime @default(now())
}

model JobSearchResult {
  id               String    @id @default(cuid())
  jobId            String    @unique
  technology       String?
  technologies     String[]
  source           String
  vendorName       String?
  vendorEmail      String?
  vendorPhone      String?
  location         String?
  isRemote         Boolean   @default(false)
  jobDescription   String?
  clientName       String?
  jobType          String?
  title            String?
  datePosted       DateTime?
  dateScraped      DateTime  @default(now())
  applyLink        String?
  rateMin          Int?
  rateMax          Int?
  visaRequirements String[]
  isActive         Boolean   @default(true)
  rawData          Json?
  // ── Job feed (ATS crawl / boards / vendor email) ──
  sourceType       String    @default("board") // ats | board | email
  atsProvider      String? // greenhouse | lever | ashby | smartrecruiters | workday
  companyName      String?
  employmentType   String? // C2C | W2 | 1099 | Contract | Full-time | Unknown
  isContract       Boolean   @default(true)
  dedupeHash       String?
  lastSeenAt       DateTime  @default(now())
  classifiedBy     String? // regex | ai
  aiParsedAt       DateTime?
  aiConfidence     Float?
  atsCompanyId     String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([dedupeHash])
  @@index([sourceType, lastSeenAt])
  @@index([classifiedBy])
  @@map("job_search_results")
}

// ── Job feed: company career boards to crawl ─────────────────────────────────
model AtsCompany {
  id            String    @id @default(cuid())
  name          String
  provider      String // greenhouse | lever | ashby | smartrecruiters | workday
  boardToken    String // greenhouse token / lever slug / ashby name / SR company id / workday tenant
  workdayHost   String? // e.g. acme.wd5.myworkdayjobs.com
  workdaySite   String    @default("") // e.g. External_Careers ("" for non-Workday, keeps the unique key strict)
  isActive      Boolean   @default(true)
  lastCrawledAt DateTime?
  lastJobCount  Int       @default(0)
  lastNewCount  Int       @default(0)
  lastError     String?
  createdAt     DateTime  @default(now())

  @@unique([provider, boardToken, workdaySite])
  @@index([isActive, lastCrawledAt])
}

model JobIngestConfig {
  id                   String    @id @default("singleton")
  paused               Boolean   @default(false)
  crawlIntervalMin     Int       @default(60)
  maxCompaniesPerCycle Int       @default(10)
  boardScrapeEnabled   Boolean   @default(false) // Apify LinkedIn/Indeed/Google — costs Apify credits
  boardScrapeHours     Int       @default(6)
  lastBoardScrapeAt    DateTime?
  aiEnabled            Boolean   @default(true) // needs ANTHROPIC_API_KEY
  aiBatchId            String? // in-flight Anthropic message batch
  aiBatchSubmittedAt   DateTime?
  emailEnabled         Boolean   @default(false) // phase 2: vendor requirement mailbox
  updatedAt            DateTime  @updatedAt
}

// ── Gmail: each user's own Workspace mailbox (OAuth, gmail.modify) ─────────

model GmailAccount {
  id                String    @id @default(cuid())
  userId            String    @unique
  email             String
  /// AES-256-GCM encrypted; never sent to the browser
  refreshTokenEnc   String
  accessTokenEnc    String?
  accessTokenExpiry DateTime?
  connectedAt       DateTime  @default(now())
  lastSyncAt        DateTime?
  /// Set when Google rejects the token (user must reconnect) or a sync fails
  lastError         String?
  /// Last time the inbox was read for vendor requirement emails
  reqScanAt         DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Emails received / sent per user per day (server-local day), filled by the Gmail stats worker
/// Google OAuth client entered in the Mailbox setup wizard (single row, id "default").
/// GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET env vars take precedence when set.
model GmailSettings {
  id              String   @id @default("default")
  clientId        String
  clientSecretEnc String
  updatedById     String?
  updatedAt       DateTime @updatedAt
}

/// One row per employee per day: emails that arrived in the Inbox and emails sent from Gmail.
/// Weekly and monthly totals are added up from these rows.
model EmailDailyStat {
  id       String   @id @default(cuid())
  userId   String
  email    String   @default("") // the employee's connected Gmail address
  day      DateTime
  received Int      @default(0)
  sent     Int      @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
}

// ── Vendor Management: each recruiter's own vendor contact book ─────────────

model RecruiterVendor {
  id                     String    @id @default(cuid())
  ownerId                String
  name                   String
  email                  String
  phone                  String?
  companyName            String
  technologies           String? // comma-separated, as typed
  clients                String?
  implementationPartners String?
  notes                  String?
  /// The vendor's current requirement (typed in, or shown from their latest requirement email)
  jobDescription         String?
  lastEmailedAt          DateTime?
  emailCount             Int       @default(0)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  owner           User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  tailoredResumes TailoredResume[]
  resumeSends     VendorResumeSend[]

  @@unique([ownerId, email])
  @@index([ownerId])
}

// ── AutoJobs: automated vendor marketing engine ─────────────────────────────

model VendorContact {
  id                 String    @id @default(cuid())
  vendorCompany      String
  recruiterName      String?
  email              String
  phone              String?
  implementationName String?
  clientName         String
  technology         String?
  lastActivityAt     DateTime?
  doNotContact       Boolean   @default(false)
  source             String    @default("import")
  createdAt          DateTime  @default(now())

  applications AutoJobApplication[]

  @@unique([email, clientName])
  @@index([clientName])
}

model AutoJobRun {
  id                  String   @id @default(cuid())
  triggerSubmissionId String
  clientName          String
  technology          String
  status              String   @default("pending") // pending → completed / no_matches / failed
  note                String?
  matchedConsultants  Int      @default(0)
  vendorsFound        Int      @default(0)
  emailsSent          Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  applications AutoJobApplication[]
}

model AutoJobApplication {
  id              String    @id @default(cuid())
  runId           String
  consultantId    String
  vendorContactId String
  vendorEmail     String
  resumeUrl       String?
  emailStatus     String    @default("queued") // queued → sent / failed / skipped
  errorMessage    String?
  sentAt          DateTime?
  createdAt       DateTime  @default(now())

  run           AutoJobRun    @relation(fields: [runId], references: [id], onDelete: Cascade)
  consultant    Student       @relation(fields: [consultantId], references: [id])
  vendorContact VendorContact @relation(fields: [vendorContactId], references: [id])

  @@unique([runId, consultantId, vendorContactId])
  @@index([consultantId, vendorEmail])
}

model AutoJobsConfig {
  id               String   @id @default("singleton")
  paused           Boolean  @default(false)
  autoSend         Boolean  @default(false) // false = dry-run: match and queue only, no emails
  dailyCap         Int      @default(100)
  maxVendorsPerRun Int      @default(25)
  cooldownDays     Int      @default(30)
  updatedAt        DateTime @updatedAt
}

// ── Attendance & leave ──────────────────────────────────────────────────────
// Days are India (IST) calendar dates, stored as DATE.

/// One row per employee per day, created by the first-login "I'm in" popup and approved by a POC / Manager / Admin
model Attendance {
  id           String    @id @default(cuid())
  userId       String
  day          DateTime  @db.Date
  status       String    @default("pending") // pending | approved | rejected
  note         String?
  markedAt     DateTime  @default(now())
  quoteId      String?
  reviewedById String?
  reviewedAt   DateTime?
  reviewNote   String?

  user       User        @relation("AttendanceUser", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User?       @relation("AttendanceReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  quote      DailyQuote? @relation(fields: [quoteId], references: [id], onDelete: SetNull)

  @@unique([userId, day])
  @@index([status, day])
}

/// Positive note shown in the attendance popup, one per day in rotation
model DailyQuote {
  id        String   @id @default(cuid())
  text      String   @unique
  author    String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  attendance Attendance[]
}

/// Leave requests. Every employee earns 1 paid leave per month; days beyond the balance are unpaid.
model LeaveRequest {
  id           String    @id @default(cuid())
  userId       String
  startDate    DateTime  @db.Date
  endDate      DateTime  @db.Date
  /// Days charged (yyyy-mm-dd): Mon–Fri in the range plus sandwiched weekends
  days         String[]
  totalDays    Int
  paidDays     Int       @default(0)
  unpaidDays   Int       @default(0)
  reason       String?
  status       String    @default("pending") // pending | approved | rejected | cancelled
  reviewedById String?
  reviewedAt   DateTime?
  reviewNote   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user       User  @relation("LeaveUser", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("LeaveReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([status])
}

// ── AI providers (Admin → AI Settings) ──────────────────────────────────────

/// An AI API an admin configured. The default enabled one is used for resume updates.
model AiProvider {
  id           String    @id @default(cuid())
  provider     String // openai | anthropic | gemini | openai-compatible
  label        String
  apiKeyEnc    String
  model        String
  baseUrl      String? // openai-compatible only (Azure, Groq, DeepSeek, OpenRouter, ...)
  isEnabled    Boolean   @default(true)
  isDefault    Boolean   @default(false)
  lastTestedAt DateTime?
  lastError    String?
  updatedById  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// ── Easy Submissions ────────────────────────────────────────────────────────

/// A consultant's resume rewritten by AI for one submission's job description, with ATS scores
/// AI-updated resumes, each with the job description it was written for (from a submission in
/// Easy Submissions, or pasted / uploaded on the Resumes tab)
model TailoredResume {
  id             String   @id @default(cuid())
  submissionId   String? // null when generated on the Resumes tab
  consultantId   String
  jobTitle       String?
  clientName     String?
  technology     String?
  jobDescription String? // the JD text the resume was tailored to
  jdFile         String? // uploaded JD file in the private resume store
  jdFileName     String? // its download name
  createdById    String
  file           String // in the private resume store
  fileName       String // download name
  atsBefore      Int // keyword match of the original resume against the JD (0–100)
  atsAfter       Int // same for the updated resume
  keywords       Json // { matched: string[], missing: string[] }
  provider       String
  model          String
  createdAt      DateTime @default(now())

  /// Written for this vendor's JD (Vendor Management)
  recruiterVendorId  String?
  /// Written for this requirement email's JD (Vendor Requirements)
  emailRequirementId String?

  submission       Submission?       @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  consultant       Student           @relation(fields: [consultantId], references: [id], onDelete: Cascade)
  recruiterVendor  RecruiterVendor?  @relation(fields: [recruiterVendorId], references: [id], onDelete: SetNull)
  emailRequirement EmailRequirement? @relation(fields: [emailRequirementId], references: [id], onDelete: SetNull)
  createdBy        User              @relation(fields: [createdById], references: [id])

  @@index([submissionId, consultantId])
  @@index([consultantId, createdAt])
  @@index([recruiterVendorId, consultantId])
  @@index([emailRequirementId, consultantId])
}

/// Every resume emailed to a vendor from Easy Submissions; also hides vendors already sent for that consultant
model EasySubmissionSend {
  id               String   @id @default(cuid())
  submissionId     String // the submission the requirement came from
  consultantId     String
  senderId         String
  vendorEmail      String
  vendorName       String?
  vendorCompany    String?
  tailoredResumeId String?
  subject          String
  via              String // gmail | smtp
  status           String // sent | failed
  error            String?
  createdAt        DateTime @default(now())

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  consultant Student    @relation(fields: [consultantId], references: [id], onDelete: Cascade)
  sender     User       @relation(fields: [senderId], references: [id])

  @@index([consultantId, vendorEmail])
  @@index([submissionId])
}

/// Follow-up emails to the vendor: up to 2 per submission (a week after submitting, then a week later)
/// and up to 2 per interview (the day after, then a week later). Replies in the original Gmail thread.
model FollowUp {
  id           String   @id @default(cuid())
  kind         String // submission | interview
  submissionId String
  interviewId  String?
  senderId     String
  sequence     Int // 1 or 2
  toEmail      String
  subject      String
  threadId     String? // Gmail thread replied in; null when sent as a new email
  inReplyTo    String? // Message-ID header of the original email
  via          String // gmail | smtp
  status       String // sent | failed
  error        String?
  createdAt    DateTime @default(now())

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  interview  Interview? @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  sender     User       @relation(fields: [senderId], references: [id])

  @@index([submissionId, kind])
  @@index([interviewId])
  @@index([senderId, createdAt])
}

/// A user's own email template (only they see and use it)
model EmailTemplate {
  id        String   @id @default(cuid())
  userId    String
  name      String
  /// submission | followup-submission | followup-interview | general
  category  String   @default("general")
  subject   String   @default("")
  body      String
  /// Pre-selected for its category
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, category])
}

/// A vendor requirement read from a recruiter's Gmail inbox (Vendor Requirements tab)
model EmailRequirement {
  id             String   @id @default(cuid())
  /// Recruiter whose inbox it came from
  ownerId        String
  /// Other recruiters who got the same email (vendors often mail several of us)
  alsoReceivedBy String[] @default([])
  gmailMessageId String
  threadId       String?
  receivedAt     DateTime
  subject        String
  fromEmail      String
  /// Same sender + subject: the same requirement mailed to several inboxes
  fingerprint    String
  jobTitle       String?
  technology     String?
  clientName     String?
  location       String?
  workMode       String?
  employmentType String?
  rate           String?
  duration       String?
  visa           String?
  jobDescription String
  vendorName     String?
  vendorCompany  String?
  vendorEmail    String?
  vendorPhone    String?
  createdAt      DateTime @default(now())

  /// Read from this consultant's mailbox (Consultant Email Configuration); null = the recruiter's own inbox
  consultantId String?

  owner           User                   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  tailoredResumes TailoredResume[]
  resumeSends     EmailRequirementSend[]

  @@index([receivedAt])
  @@index([fingerprint])
  @@index([createdAt])
}

/// Each inbox message checked for requirements, so none is read (or sent to the AI) twice
model EmailScan {
  id             String   @id @default(cuid())
  ownerId        String
  gmailMessageId String
  /// requirement | duplicate | skipped | failed
  status         String
  createdAt      DateTime @default(now())

  @@unique([ownerId, gmailMessageId])
  @@index([createdAt])
}

/// A consultant's own Gmail (the one used to market them), connected by their recruiter with read and send access
model ConsultantMailbox {
  id                String    @id @default(cuid())
  consultantId      String    @unique
  email             String
  /// "app_password": Gmail address + Google App Password over IMAP/SMTP; "oauth": Google sign-in
  authType          String    @default("oauth")
  /// OAuth only (AES-256-GCM encrypted; never sent to the browser)
  refreshTokenEnc   String?
  /// App password only (AES-256-GCM encrypted; never sent to the browser)
  appPasswordEnc    String?
  accessTokenEnc    String?
  accessTokenExpiry DateTime?
  connectedById     String
  connectedAt       DateTime  @default(now())
  /// Set when Google rejects the token or app password (must reconnect)
  lastError         String?
  /// Last time it was read for vendor requirement emails
  reqScanAt         DateTime?

  consultant  Student @relation(fields: [consultantId], references: [id], onDelete: Cascade)
  connectedBy User    @relation(fields: [connectedById], references: [id])
}

/// A consultant's resume emailed to a vendor from Vendor Management
model VendorResumeSend {
  id               String   @id @default(cuid())
  vendorId         String
  consultantId     String
  senderId         String
  tailoredResumeId String?
  subject          String
  via              String
  status           String
  error            String?
  createdAt        DateTime @default(now())

  vendor     RecruiterVendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  consultant Student         @relation(fields: [consultantId], references: [id], onDelete: Cascade)

  @@index([vendorId, consultantId])
}

/// A consultant's resume emailed to the vendor of a requirement (Vendor Requirements)
model EmailRequirementSend {
  id               String   @id @default(cuid())
  requirementId    String
  consultantId     String
  senderId         String
  tailoredResumeId String?
  toEmail          String
  subject          String
  via              String
  status           String
  error            String?
  createdAt        DateTime @default(now())

  requirement EmailRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  consultant  Student          @relation(fields: [consultantId], references: [id], onDelete: Cascade)

  @@index([requirementId, consultantId])
}

/// Who did what in the app: sign-ins (and failed attempts), sign-outs and every tab opened, with the IP address.
model ActivityLog {
  id        String   @id @default(cuid())
  /// Null for a failed sign-in with an unknown email
  userId    String?
  /// The email typed or signed in with
  email     String
  /// login | login_failed | logout | page
  kind      String
  /// For page views: the path and the tab's name
  path      String?
  tab       String?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId, createdAt])
  @@map("activity_logs")
}

/// Profit Sharing → Confirmations: a confirmed placement, entered by submission id. Details are copied
/// from the submission / interview when saved, so the record stands even if those change later.
model Confirmation {
  id                 String    @id @default(cuid())
  /// Submission.id (one confirmation per submission) and its "Sub-NNN" code
  submissionRefId    String    @unique
  submissionCode     String
  /// Interview.id and its code, when the submission has one
  interviewRefId     String?
  interviewCode      String?
  consultantId       String
  consultantName     String
  clientName         String?
  implementationName String?
  vendorCompany      String?
  rate               String?
  confirmationDate   DateTime  @db.Date
  startDate          DateTime? @db.Date
  endDate            DateTime? @db.Date
  createdById        String
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([confirmationDate])
  @@map("confirmations")
}

/// Incentives → Placements: a recruiter's placement, entered by submission id (details copied from the
/// submission when saved). The Calculations page works the monthly incentive out from these.
model IncentivePlacement {
  id                 String    @id @default(cuid())
  submissionRefId    String    @unique
  submissionCode     String
  interviewRefId     String?
  interviewCode      String?
  /// The submission's recruiter: whose incentive this is
  recruiterId        String
  consultantId       String
  consultantName     String
  clientName         String?
  implementationName String?
  vendorCompany      String?
  rate               String?
  /// Bill rate in $ per hour; the monthly incentive is worked out from it
  billRate           Float?
  confirmationDate   DateTime  @db.Date
  startDate          DateTime? @db.Date
  endDate            DateTime? @db.Date
  /// pending | approved | rejected. Only a Super Admin approves; only approved ones earn incentive
  status             String    @default("pending")
  reviewedById       String?
  reviewedAt         DateTime?
  reviewNote         String?
  createdById        String
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([recruiterId])
  @@index([status])
  @@map("incentive_placements")
}

/// Appreciation: each month's top recruiter by submissions and by interviews shares a prize (ties split it).
/// Written once, on the 1st, for the month before.
model AppreciationAward {
  id        String   @id @default(cuid())
  /// "yyyy-mm" the award is for
  month     String
  /// submissions | interviews
  category  String
  userId    String
  /// The winning number of submissions / interviews
  count     Int
  /// Rupees: the prize divided by the number of winners
  amount    Float
  createdAt DateTime @default(now())

  @@unique([month, category, userId])
  @@index([userId])
  @@map("appreciation_awards")
}
